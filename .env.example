# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/honest_congress
# For local development without PostgreSQL, use SQLite:
# DATABASE_URL=sqlite:///./honest_congress.db

# Congress.gov API key. Optional for the member roster (congress-legislators
# covers that without a key) but REQUIRED by `ingest-bills`, which joins trades
# to bill sponsorship and committee referrals.
# Free at https://api.congress.gov/sign-up/ -- 20,000 requests/hour.
CONGRESS_GOV_API_KEY=

# Analysis thresholds
WEALTH_GROWTH_THRESHOLD_PERCENT=200
CONGRESSIONAL_SALARY=174000

# Late-filing detector. Trades on PTRs filed more than this many days late
# AND with amount >= the min USD threshold get flagged. Defaults tuned for
# a manageable signal-to-noise ratio.
LATE_FILING_MIN_DAYS=60
LATE_FILING_MIN_AMOUNT_USD=50000

# Detectors disabled by default because their output is not defensible:
#   outperforming_trades - benchmarks against a hardcoded flat 10% return
#   perfect_timing       - never reads a price; rates can exceed 100%
#   loss_avoidance       - numerator == denominator, so the rate is always 100%
# Re-enabling these requires real price history. Set to an empty string to
# disable nothing. After changing, run: python -m src.cli purge-disabled
DISABLED_ANOMALY_TYPES=outperforming_trades,perfect_timing,loss_avoidance

# FEC API key, for corporate PAC donations (`ingest-donations`).
# Free at https://api.data.gov/signup/ -- 1,000 requests/hour.
FEC_API_KEY=

# Senate LDA key, for lobbying disclosures (`ingest-lobbying`). OPTIONAL:
# anonymous callers get ~15 requests/minute, keyed callers ~120. Free at
# https://lda.senate.gov/api/register/
LDA_API_KEY=

# SEC requires a contact email in the User-Agent for its company register
# (used to resolve company names to tickers). Requests without one get a 403.
# Set this to an address you actually monitor.
SEC_CONTACT_EMAIL=contact@example.com

# Admin auth (required to call mutating /api/anomalies/* endpoints)
ADMIN_PASSWORD=

# Logging
LOG_LEVEL=INFO
