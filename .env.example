# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/honest_congress
# For local development without PostgreSQL, use SQLite:
# DATABASE_URL=sqlite:///./honest_congress.db

# Congress.gov API Key (optional - primary source theunitedstates.io doesn't need it)
# Get a free key at https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=

# Analysis thresholds
WEALTH_GROWTH_THRESHOLD_PERCENT=200
CONGRESSIONAL_SALARY=174000

# Late-filing detector. Trades on PTRs filed more than this many days late
# AND with amount >= the min USD threshold get flagged. Defaults tuned for
# a manageable signal-to-noise ratio.
LATE_FILING_MIN_DAYS=60
LATE_FILING_MIN_AMOUNT_USD=50000

# QuiverQuant API key (optional, for trade data)
QUIVERQUANT_API_KEY=

# Admin auth (required to call mutating /api/anomalies/* endpoints)
ADMIN_PASSWORD=

# Logging
LOG_LEVEL=INFO
