# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/honest_congress
# For local development without PostgreSQL, use SQLite:
# DATABASE_URL=sqlite:///./honest_congress.db

# Congress.gov API Key (optional - primary source theunitedstates.io doesn't need it)
# Get a free key at https://api.congress.gov/sign-up/
CONGRESS_GOV_API_KEY=

# Analysis thresholds
WEALTH_GROWTH_THRESHOLD_PERCENT=200
CONGRESSIONAL_SALARY=174000

# Logging
LOG_LEVEL=INFO
